# Environment & Secrets
**/.env
**/.env.*
!**/.env.example

# Composer & Vendor
/vendor/
public_html/vendor/
!**/Modules/**/Vendor/
!**/Modules/**/Vendor/**
!**/Modules/**/vendor/
!**/Modules/**/vendor/**

# Node & NPM
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Laravel Storage & Cache
**/storage/**
!**/storage/**/.gitignore
**/bootstrap/cache/*
!**/bootstrap/cache/.gitignore
**/public/hot
**/public/storage

# Database Dumps (keep clean migration SQL in database/sql/)
*.sql
**/*.sql
!**/database/sql/*.sql


# Keep Compiled Assets
!**/public/build/**

# Archives & Backups
*.zip
*.tar.gz
*.rar
*.7z

# Flutter Mobile App (Local Only - Untracked from Git)
Mobile Source/
**/Mobile Source/**

# IDE & OS
.idea/
.vscode/
**/.idea/
**/.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
